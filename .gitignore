# Documentation reference folder
.docs-reference/

# Hugo build output. Regenerated by `hugo` — nothing depends on it being
# committed, and the dev server rewrites every file in here (livereload
# scripts, a localhost baseURL) which made every commit a coin flip on
# whether the build was publishable.
public/

# Hugo's build lock
.hugo_build.lock

# never commit local secrets
.env
*.env

# Secrets never belong in this public repo. The announcements bot token lives
# outside it (~/.config/fau-announcements/env); these are a backstop.
.env
*.env
secrets/
